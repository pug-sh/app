{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Vendored or generated: no finding in any of these is one we would act on. genproto is
  // regenerated by `bun run generate`, charts and ui are re-added from their registries.
  // The cost is that dead files there go unreported too, and un-ignoring ui reports ~44 exports
  // that are legitimate registry API. Don't add src/components/shimmering-text.tsx: it is vendored
  // but reachable through the chart zone, so listing it earns a "Remove from ignore" hint.
  "ignore": ["src/api/genproto/**", "src/components/charts/**", "src/components/ui/**"],
  // Replaces knip's default entry patterns rather than extending them. Safe only because plugin
  // entries are separate and additive: Vite roots the app graph at index.html -> src/main.tsx. The
  // CLA gate is its own program with its own runner, so it roots its own graph. The tests are the
  // only entry it needs: they reach main.ts and test-support.ts, and naming main.ts as well earns
  // a "redundant entry pattern" hint. scripts/generate-themes.ts needs no line either, since knip
  // finds it through the generate:themes script.
  "entry": ["scripts/gen-favicons.mjs", "tools/cla/gate/*.test.ts"],
  // Flip to false for a second tier of ~35 `export` keywords on symbols only used in their own
  // file. Worth a periodic sweep, but some are deliberate module API (lib/granularity.ts,
  // analytics/sanitize-url.ts), so this is not a gate we can be red on.
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // buf.gen.yaml runs it as a `local:` plugin binary, so there is no import site to find.
    "@bufbuild/protoc-gen-es",
    // Its only importer is ignored and dead-ends (visx-pattern <- pattern-preset <- bar-squares <-
    // nothing), so knip never parses it. cmdk, react-day-picker and class-variance-authority are
    // ui-only too but need no line, because app code imports the files that use them.
    "@visx/pattern"
  ]
}
